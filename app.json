{
  "expo": {
    "name": "Speak the Word",
    "slug": "speak-the-word",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "scheme": "speaktheword",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0B1E4A"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.jagoalt.speaktheword",
      "infoPlist": {
        "NSSpeechRecognitionUsageDescription": "Speak the Word uses speech recognition so it can check the verse you recite.",
        "NSMicrophoneUsageDescription": "Speak the Word uses the microphone so you can recite Scripture aloud.",
        "NSPhotoLibraryUsageDescription": "Speak the Word does not access your photos. This description is required because a linked library references photo library APIs.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "backgroundColor": "#0B1E4A",
        "foregroundImage": "./assets/android-icon-foreground.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ],
      "package": "com.jagoalt.speaktheword"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Speak the Word uses the microphone so you can recite Scripture aloud.",
          "speechRecognitionPermission": "Speak the Word uses speech recognition so it can check the verse you recite."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#0B1E4A"
        }
      ],
      "expo-sqlite",
      "expo-router",
      "expo-font"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "9250772c-fda5-4d89-9255-a79c13daefd5"
      }
    },
    "owner": "josephfitz7"
  }
}
